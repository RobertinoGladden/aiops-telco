# Local development defaults. Copy to .env; application settings load it automatically.
COMPOSE_PROJECT_NAME=telco-aiops-v2
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
KAFKA_TOPIC=telco.network.metrics
KAFKA_DLQ_TOPIC=telco.network.dead-letter
KAFKA_PREDICTIONS_TOPIC=telco.network.predictions
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=telcoadmin
MINIO_SECRET_KEY=telcopassword123
MINIO_BUCKET_RAW=telco-raw-data
MINIO_BUCKET_PROC=telco-processed-data
MINIO_BUCKET_MODELS=telco-models
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MODEL_NAME=random_forest
MODEL_API_URL=http://127.0.0.1:8081
INTEGRATION_HUB_URL=http://127.0.0.1:8082
INTEGRATION_API_TOKEN=local-lab-change-me
CONNECTOR_POLL_SECONDS=30
INCIDENT_CONFIRMATIONS=3
RECOVERY_CONFIRMATIONS=3
STORAGE_BATCH_SIZE=500
STORAGE_BATCH_SECONDS=30
NUM_DEVICES=50
SEND_INTERVAL=1.0
GRAFANA_ADMIN_PASSWORD=telco123

# Existing field/lab installations. In Docker, use host.docker.internal for host services.
NETBOX_ENABLED=false
NETBOX_URL=http://host.docker.internal:8000
NETBOX_TOKEN=
ZABBIX_ENABLED=false
ZABBIX_URL=http://host.docker.internal/zabbix
ZABBIX_TOKEN=
LIBRENMS_ENABLED=false
LIBRENMS_URL=http://host.docker.internal:8085
LIBRENMS_TOKEN=
GNS3_ENABLED=false
GNS3_URL=http://host.docker.internal:3080
GNS3_USERNAME=
GNS3_PASSWORD=
GNS3_PROJECT_ID=
EVE_NG_ENABLED=false
EVE_NG_URL=http://192.168.56.101
EVE_NG_USERNAME=admin
EVE_NG_PASSWORD=
EVE_NG_LAB_PATH=aiops.unl

# Optional workflow endpoint (n8n, AWX gateway, or an operations backend).
# The receiver must honor Idempotency-Key and execute its own approved runbooks.
WORKFLOW_ENABLED=false
WORKFLOW_WEBHOOK_URL=
WORKFLOW_WEBHOOK_TOKEN=

# AI Operations Console: Groq analysis -> OpenAI Decisions -> operator review.
# Keys stay on the server. Analyze is on-demand and sends bounded incident facts.
AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
DECISION_MODEL=gpt-6-luna
AI_TIMEOUT_SECONDS=20
AI_MAX_RUNS_PER_DAY=50
AI_COOLDOWN_SECONDS=30
AI_MAX_EVIDENCE_AGE_SECONDS=300
# Initial review threshold; calibrate against labeled field incidents.
AI_MIN_CONFIDENCE=0.85
PROMETHEUS_URL=http://127.0.0.1:9090
GRAFANA_URL=http://127.0.0.1:3000
AIRFLOW_URL=
ALERTMANAGER_URL=http://127.0.0.1:9093
STORAGE_METRICS_URL=http://127.0.0.1:9101
PREDICTOR_METRICS_URL=http://127.0.0.1:9102
STORAGE_METRICS_PORT=9101
PREDICTOR_METRICS_PORT=9102

# Optional Airflow profile
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=telco123
AIRFLOW_FERNET_KEY=
