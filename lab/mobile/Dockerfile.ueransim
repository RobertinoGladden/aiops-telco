FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git make gcc g++ cmake libsctp-dev lksctp-tools iproute2 iputils-ping iperf3 python3 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git init && git remote add origin https://github.com/aligungr/UERANSIM.git && git fetch --depth=1 origin 1d1e154f869260b5e98f6905827b1bd9b8663afc && git checkout --detach FETCH_HEAD && make -j 2
ENTRYPOINT []
