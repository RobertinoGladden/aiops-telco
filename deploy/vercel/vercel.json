{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "node build.mjs",
  "installCommand": "",
  "functions": {"api/proxy.mjs": {"maxDuration": 60}},
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"},
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "X-Frame-Options", "value": "DENY"},
    {"key": "Referrer-Policy", "value": "no-referrer"},
    {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
    {"key": "Cache-Control", "value": "no-store"}
  ]}],
  "rewrites": [
    {"source": "/console/overview", "destination": "/api/proxy?route=overview"},
    {"source": "/connectors", "destination": "/api/proxy?route=connectors"},
    {"source": "/inventory", "destination": "/api/proxy?route=inventory"},
    {"source": "/topology", "destination": "/api/proxy?route=topology"},
    {"source": "/incidents", "destination": "/api/proxy?route=incidents"},
    {"source": "/ai/status", "destination": "/api/proxy?route=aiStatus"},
    {"source": "/ai/decisions", "destination": "/api/proxy?route=decisions"},
    {"source": "/incidents/:id/history", "destination": "/api/proxy?route=history&id=:id"},
    {"source": "/incidents/:id/analyze", "destination": "/api/proxy?route=analyze&id=:id"},
    {"source": "/ai/decisions/:id/request-review", "destination": "/api/proxy?route=review&id=:id"}
  ]
}
